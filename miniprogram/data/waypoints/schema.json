{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cloudseashell.example/schemas/waypoints.schema.json",
  "title": "CloudSeaShell waypoint list",
  "type": "array",
  "minItems": 15,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "lat",
      "lng",
      "elevation",
      "bestFor",
      "bestSeasons",
      "suggestedDirection",
      "notes",
      "bortleClass"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "name": { "type": "string", "minLength": 1 },
      "lat": { "type": "number", "minimum": -90, "maximum": 90 },
      "lng": { "type": "number", "minimum": -180, "maximum": 180 },
      "elevation": { "type": "number", "minimum": -500 },
      "bestFor": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "enum": ["cloudsea", "stargazing", "sunset", "sunrise"] }
      },
      "bestSeasons": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "suggestedDirection": { "type": "number", "minimum": 0, "maximum": 359 },
      "notes": { "type": "string", "minLength": 1 },
      "bortleClass": { "type": "integer", "minimum": 1, "maximum": 9 }
    }
  }
}
