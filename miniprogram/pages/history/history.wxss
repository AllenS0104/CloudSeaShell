/* History Page Styles */
.page-container {
  padding: 20rpx;
  padding-bottom: 60rpx;
  min-height: 100vh;
}

/* ===== Header ===== */
.history-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.history-header-left {
  display: flex;
  flex-direction: column;
}

.history-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.history-subtitle {
  font-size: 24rpx;
  color: #aab4c5;
  margin-top: 6rpx;
}

.export-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  background: rgba(58, 164, 255, 0.12);
  border: 1rpx solid rgba(58, 164, 255, 0.3);
  border-radius: 12rpx;
  flex-shrink: 0;
}

.export-icon {
  font-size: 28rpx;
}

.export-label {
  font-size: 24rpx;
  color: #3aa4ff;
  font-weight: 500;
}

/* ===== Stats Overview ===== */
.stats-overview {
  margin-bottom: 24rpx;
}

.stats-grid-4 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-block {
  flex: 1;
  min-width: 140rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0, 0, 0, 0.25);
  padding: 20rpx 12rpx;
  border-radius: 16rpx;
}

.stat-big-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.stat-accent {
  color: #3aa4ff;
}

.stat-muted {
  color: #6c757d;
}

.stat-block-label {
  font-size: 22rpx;
  color: #aab4c5;
  margin-top: 6rpx;
}

/* ===== Empty State ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  margin-top: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #aab4c5;
  margin-bottom: 32rpx;
}

.empty-btn {
  padding: 16rpx 48rpx;
  background: #3aa4ff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

/* ===== Record Card ===== */
.records-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-card {
  padding: 28rpx 30rpx;
}

.record-header {
  margin-bottom: 20rpx;
}

.record-date-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-date {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.record-location {
  font-size: 24rpx;
  color: #aab4c5;
}

/* ===== Prediction Scores ===== */
.pred-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.pred-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 12rpx;
  background: rgba(0, 0, 0, 0.2);
  border: 2rpx solid transparent;
}

/* Accuracy color coding */
.pred-hit {
  border-color: rgba(40, 167, 69, 0.5);
  background: rgba(40, 167, 69, 0.1);
}

.pred-miss {
  border-color: rgba(220, 53, 69, 0.5);
  background: rgba(220, 53, 69, 0.1);
}

.pred-none {
  border-color: transparent;
}

.pred-icon {
  font-size: 32rpx;
}

.pred-label {
  font-size: 22rpx;
  color: #aab4c5;
  margin-top: 4rpx;
}

.pred-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  margin-top: 4rpx;
}

.pred-hit .pred-score {
  color: #28a745;
}

.pred-miss .pred-score {
  color: #ff6b6b;
}

/* ===== Feedback Status ===== */
.feedback-row {
  display: flex;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.fb-status-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 10rpx 8rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.status-yes {
  background: rgba(40, 167, 69, 0.12);
}

.status-no {
  background: rgba(220, 53, 69, 0.12);
}

.status-pending {
  background: rgba(108, 117, 125, 0.12);
}

.fb-status-text {
  font-size: 22rpx;
  color: #aab4c5;
}

.status-yes .fb-status-text {
  color: #28a745;
}

.status-no .fb-status-text {
  color: #ff6b6b;
}

/* ===== Rating Stars ===== */
.rating-row {
  display: flex;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.rating-star {
  font-size: 32rpx;
}

.star-active {
  color: #ffc107;
}

.star-dim {
  color: rgba(108, 117, 125, 0.3);
}

/* ===== Note ===== */
.record-note {
  padding: 12rpx 16rpx;
  background: rgba(0, 0, 0, 0.15);
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.note-label {
  font-size: 22rpx;
  color: #aab4c5;
}

.note-text {
  font-size: 24rpx;
  color: #ccd;
  line-height: 1.6;
}
