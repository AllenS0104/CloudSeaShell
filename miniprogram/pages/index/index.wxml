<view class="page-container">
  <!-- Header -->
  <view class="card header">
    <view class="header-eyebrow">CLOUD SEA FORECAST LAB</view>
    <view class="header-title">云海观测决策台</view>
    <view class="header-subtitle">面向摄影、徒步与山地观测的专业天气研判工具</view>
    <view class="controls">
      <input class="search-input" placeholder="输入地点（默认：北京）" value="{{searchText}}" bindinput="onSearchInput" bindconfirm="onSearch" />
      <button class="btn-primary" bindtap="onSearch">确认</button>
      <button class="btn-locate" bindtap="onLocate">📍 当前位置</button>
    </view>
    <picker mode="selector" range="{{dayLabels}}" value="{{selectedDayIndex}}" bindchange="onDayChange">
      <view class="btn-primary" style="margin-top:16rpx;text-align:center;">{{dayLabels[selectedDayIndex] || '选择日期'}}</view>
    </picker>
  </view>

  <!-- Status Banner -->
  <view wx:if="{{statusText}}" class="status-banner status-{{statusType}}">{{statusText}}</view>

  <!-- Hero Decision Card -->
  <view wx:if="{{heroCard && !loading}}" class="hero-card {{heroCard.bgClass}}">
    <text class="hero-emoji">{{heroCard.emoji}}</text>
    <text class="hero-text">{{heroCard.text}}</text>
  </view>

  <!-- Loading Skeleton -->
  <view wx:if="{{loading}}" class="skeleton-container">
    <!-- Header placeholder -->
    <view class="skeleton-header">
      <view class="skeleton-block skeleton-pulse" style="width:40%;height:40rpx;margin:0 auto 16rpx;"></view>
      <view class="skeleton-block skeleton-pulse" style="width:60%;height:60rpx;margin:0 auto 16rpx;"></view>
      <view class="skeleton-block skeleton-pulse" style="width:80%;height:30rpx;margin:0 auto;"></view>
    </view>
    <!-- Map placeholder -->
    <view class="skeleton-block skeleton-pulse skeleton-map"></view>
    <!-- Stats row 1 -->
    <view class="skeleton-stats-row">
      <view class="skeleton-block skeleton-pulse skeleton-stat"></view>
      <view class="skeleton-block skeleton-pulse skeleton-stat"></view>
      <view class="skeleton-block skeleton-pulse skeleton-stat"></view>
    </view>
    <!-- Stats row 2 -->
    <view class="skeleton-stats-row">
      <view class="skeleton-block skeleton-pulse skeleton-stat"></view>
      <view class="skeleton-block skeleton-pulse skeleton-stat"></view>
      <view class="skeleton-block skeleton-pulse skeleton-stat"></view>
    </view>
    <!-- Forecast card placeholder -->
    <view class="skeleton-forecast">
      <view class="skeleton-block skeleton-pulse" style="width:50%;height:36rpx;margin:0 auto 20rpx;"></view>
      <view class="skeleton-block skeleton-pulse" style="width:90%;height:80rpx;margin:0 auto 16rpx;border-radius:12rpx;"></view>
      <view class="skeleton-block skeleton-pulse" style="width:100%;height:28rpx;margin-bottom:10rpx;"></view>
      <view class="skeleton-block skeleton-pulse" style="width:85%;height:28rpx;"></view>
    </view>
  </view>

  <!-- Main Content -->
  <view wx:if="{{!loading && weatherData}}">
    <!-- Map -->
    <view class="card">
      <view class="section-heading">
        <view class="section-eyebrow">OBSERVATION DASHBOARD</view>
        <view class="section-title">观测条件总览</view>
      </view>
      <map class="map-container"
        latitude="{{lat}}" longitude="{{lon}}"
        scale="10" show-location
        markers="{{markers}}"
        bindtap="onMapTap">
      </map>

      <!-- Weather Stats -->
      <view class="weather-main">
        <view class="temp">{{currentTemp}}°<text class="temp-sub">/{{currentFeelsLike}}°</text></view>
        <view class="location-text">{{locationName}}</view>
      </view>

      <view class="stats-grid">
        <view class="stat-card">
          <text class="stat-icon">💧</text>
          <view><view class="stat-label">湿度</view><view class="stat-value">{{currentHumidity}}%</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🌬️</text>
          <view><view class="stat-label">风速</view><view class="stat-value">{{currentWind}} m/s</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">☁️</text>
          <view><view class="stat-label">云量</view><view class="stat-value">{{currentCloudCover}}%</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">⛰️</text>
          <view><view class="stat-label">海拔</view><view class="stat-value">{{elevation}} m</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🌫️</text>
          <view><view class="stat-label">云底高度</view><view class="stat-value">{{analysis.cloudBase}} m</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">💧</text>
          <view><view class="stat-label">露点差</view><view class="stat-value">{{currentDewGap}}°C</view></view>
        </view>
      </view>
    </view>

    <!-- Forecast -->
    <view class="card">
      <view class="section-heading">
        <view class="section-eyebrow">FORECAST ASSESSMENT</view>
        <view class="section-title">云海判断</view>
      </view>

      <view class="forecast-card">
        <view class="forecast-title">{{selectedDayIndex === 0 ? '今日' : '全天'}}云海预测</view>
        <view class="forecast-result {{analysis.suggestion ? 'forecast-positive' : 'forecast-negative'}}">
          {{analysis.resultText}}
        </view>
      </view>

      <view class="forecast-summary">{{analysis.summary}}</view>

      <view class="forecast-reasons">
        <view wx:for="{{analysis.reasons}}" wx:key="index" class="reason-item">{{item}}</view>
      </view>

      <view class="disclaimer">⚠️ 预测仅供参考，基于数值天气模式估算，实际云海受微地形、局地气流等因素影响，请结合现场条件判断。</view>
    </view>

    <!-- Sunset Glow Prediction -->
    <view class="card" wx:if="{{glowAnalysis}}">
      <view class="section-heading">
        <view class="section-eyebrow">SUNSET GLOW FORECAST</view>
        <view class="section-title">🌅 晚霞 / 火烧云预测</view>
      </view>

      <view class="forecast-card">
        <view class="forecast-result {{glowAnalysis.score >= 50 ? 'forecast-positive' : 'forecast-negative'}}" style="{{glowAnalysis.score >= 70 ? 'color:#ff6b35;background:rgba(255,107,53,0.18);' : ''}}">
          {{glowAnalysis.resultText}}
        </view>
      </view>

      <view class="stats-grid" style="margin-top:16rpx;" wx:if="{{glowAnalysis.bestSunrise || glowAnalysis.bestSunset}}">
        <view class="stat-card" wx:if="{{glowAnalysis.bestSunrise}}">
          <text class="stat-icon">🌄</text>
          <view><view class="stat-label">日出霞光</view><view class="stat-value">{{glowAnalysis.bestSunrise.score}} 分</view></view>
        </view>
        <view class="stat-card" wx:if="{{glowAnalysis.bestSunset}}">
          <text class="stat-icon">🌇</text>
          <view><view class="stat-label">日落霞光</view><view class="stat-value">{{glowAnalysis.bestSunset.score}} 分</view></view>
        </view>
      </view>

      <view class="forecast-summary">{{glowAnalysis.summary}}</view>
      <view class="forecast-reasons">
        <view wx:for="{{glowAnalysis.reasons}}" wx:key="index" class="reason-item">{{item}}</view>
      </view>
      <view class="disclaimer">🌅 晚霞预测基于中高层云量、低云遮挡、湿度和能见度综合评估。最佳观赏窗口为日落前 30 分钟至日落后 15 分钟。</view>
    </view>

    <!-- Stargazing / Milky Way -->
    <view class="card" wx:if="{{starInfo}}">
      <view class="section-heading">
        <view class="section-eyebrow">STARGAZING FORECAST</view>
        <view class="section-title">🌌 银河 / 星空预测</view>
      </view>

      <view class="forecast-card">
        <view class="forecast-result {{starInfo.score >= 50 ? 'forecast-positive' : 'forecast-negative'}}" style="{{starInfo.score >= 70 ? 'color:#b388ff;background:rgba(179,136,255,0.18);' : ''}}">
          {{starInfo.resultText}}
        </view>
      </view>

      <view class="stats-grid" style="margin-top:16rpx;">
        <view class="stat-card">
          <text class="stat-icon">{{starInfo.moonPhase.icon}}</text>
          <view><view class="stat-label">月相</view><view class="stat-value">{{starInfo.moonPhase.name}}</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🔦</text>
          <view><view class="stat-label">月面亮度</view><view class="stat-value">{{starInfo.moonIllum}}%</view></view>
        </view>
        <view class="stat-card">
          <text class="stat-icon">🌌</text>
          <view><view class="stat-label">银河核心</view><view class="stat-value">{{starInfo.milkyWay.coreVisible ? '可见' : '不可见'}}</view></view>
        </view>
        <view class="stat-card" wx:if="{{starInfo.milkyWay.coreVisible}}">
          <text class="stat-icon">🕐</text>
          <view><view class="stat-label">最佳时段</view><view class="stat-value">{{starInfo.milkyWay.bestHours}}</view></view>
        </view>
      </view>

      <view class="forecast-reasons" style="margin-top:12rpx;">
        <view wx:for="{{starInfo.reasons}}" wx:key="index" class="reason-item">{{item}}</view>
      </view>

      <!-- Astrophotography quick params -->
      <view style="margin-top:16rpx;">
        <view class="photo-device-title" style="color:#b388ff;">📷 星空摄影参数</view>
        <view class="photo-grid">
          <view class="photo-param">
            <view class="photo-param-label">光圈</view>
            <view class="photo-param-value">{{starInfo.astro.aperture}}</view>
          </view>
          <view class="photo-param">
            <view class="photo-param-label">快门</view>
            <view class="photo-param-value">{{starInfo.astro.shutter}}</view>
            <view class="photo-param-note">{{starInfo.astro.shutterNote}}</view>
          </view>
          <view class="photo-param">
            <view class="photo-param-label">ISO</view>
            <view class="photo-param-value">{{starInfo.astro.iso}}</view>
          </view>
          <view class="photo-param">
            <view class="photo-param-label">白平衡</view>
            <view class="photo-param-value">{{starInfo.astro.wb}}</view>
          </view>
        </view>
        <view class="photo-grid" style="margin-top:8rpx;">
          <view class="photo-param">
            <view class="photo-param-label">对焦</view>
            <view class="photo-param-value">{{starInfo.astro.focus}}</view>
            <view class="photo-param-note">{{starInfo.astro.focusNote}}</view>
          </view>
          <view class="photo-param">
            <view class="photo-param-label">堆栈降噪</view>
            <view class="photo-param-value" style="font-size:24rpx;">{{starInfo.astro.stacking}}</view>
          </view>
        </view>
      </view>

      <view class="disclaimer">🌌 银河核心（人马座方向）在北半球 4-10 月可见。新月前后 ±5 天是最佳观测窗口。高海拔、远离城市光污染的地点效果最佳。</view>
    </view>

    <!-- Safety Alerts -->
    <view wx:if="{{safetyAlerts.length}}" style="margin-bottom:20rpx;">
      <view wx:for="{{safetyAlerts}}" wx:key="text" class="safety-alert safety-{{item.type}}">
        <text>{{item.icon}} {{item.text}}</text>
      </view>
    </view>

    <!-- Guidance -->
    <view class="card" wx:if="{{guidance}}">
      <view class="section-heading">
        <view class="section-eyebrow">ACTION GUIDANCE</view>
        <view class="section-title">观测行动建议</view>
      </view>
      <view class="guidance-card">
        <view class="guidance-level guidance-{{guidance.goClass}}">{{guidance.goLevel}}</view>
        <view class="guidance-grid">
          <view class="guidance-item">
            <view class="guidance-label">推荐时段</view>
            <view class="guidance-value">{{guidance.recommendedWindow}}</view>
          </view>
          <view class="guidance-item">
            <view class="guidance-label">日出日落</view>
            <view class="guidance-value">{{guidance.daylightWindow}}</view>
          </view>
          <view class="guidance-item">
            <view class="guidance-label">机位建议</view>
            <view class="guidance-value">{{guidance.viewpointAdvice}}</view>
          </view>
        </view>
        <view class="forecast-reasons" style="margin-top:16rpx;">
          <view wx:for="{{guidance.actionItems}}" wx:key="index" class="reason-item">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- Hourly -->
    <view class="card">
      <view class="section-heading">
        <view class="section-eyebrow">HOURLY TIMELINE</view>
        <view class="section-title">逐小时预报</view>
      </view>
      <view class="hourly-section">
        <view class="hourly-header">
          <view class="hourly-col-time">时间</view>
          <view class="hourly-col-temp">🌡️温度</view>
          <view class="hourly-col-cloud">🌫️云底</view>
          <view class="hourly-col-precip">💦降水</view>
        </view>
        <scroll-view scroll-y style="max-height:600rpx;">
          <view wx:for="{{hourlyList}}" wx:key="time" class="hour-item">
            <view class="hour-time">{{item.time}}</view>
            <view class="hour-value">{{item.temp}}°</view>
            <view class="hour-value">{{item.cloudBase}}m</view>
            <view class="hour-value">{{item.precip}}%</view>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- Photography Parameters (moved to popup) -->

    <!-- Multi-Model Fusion -->
    <view class="card" wx:if="{{fusionResult || fusionLoading}}">
      <view class="section-heading">
        <view class="section-eyebrow">MULTI-MODEL FUSION</view>
        <view class="section-title">多模式融合预测</view>
      </view>

      <view wx:if="{{fusionLoading}}" class="loading-text">正在获取多模式数据（ICON（德国）/ GFS（美国）/ JMA（日本）/ ECMWF（欧洲））...</view>

      <view wx:if="{{fusionResult}}">
        <view class="forecast-card">
          <view class="forecast-result {{fusionResult.fusedSuggestion ? 'forecast-positive' : 'forecast-negative'}}">
            {{fusionResult.resultText}}
          </view>
        </view>

        <view class="stats-grid" style="margin-top:16rpx;">
          <view class="stat-card">
            <text class="stat-icon">🔗</text>
            <view><view class="stat-label">模式数量</view><view class="stat-value">{{fusionResult.modelCount}} 个</view></view>
          </view>
          <view class="stat-card">
            <text class="stat-icon" style="color:{{fusionResult.agreement.color}}">●</text>
            <view><view class="stat-label">一致性</view><view class="stat-value">{{fusionResult.agreement.label}}</view></view>
          </view>
          <view class="stat-card" wx:if="{{fusionResult.timeConsensus}}">
            <text class="stat-icon">🕐</text>
            <view><view class="stat-label">共识时段</view><view class="stat-value">{{fusionResult.timeConsensus}}</view></view>
          </view>
          <view class="stat-card">
            <text class="stat-icon">🌡️</text>
            <view><view class="stat-label">逆温层</view><view class="stat-value">{{fusionResult.inversionConsensus ? '多数检测到' : '未明显检测'}}</view></view>
          </view>
        </view>

        <view class="forecast-summary" style="margin-top:12rpx;">{{fusionResult.summary}}</view>

        <!-- Per-model breakdown -->
        <view style="margin-top:16rpx;">
          <view class="section-eyebrow" style="margin-bottom:8rpx;">各模式得分</view>
          <view wx:for="{{fusionResult.modelDetails}}" wx:key="name" class="hour-item">
            <view class="hour-time">{{item.name}}</view>
            <view class="hour-value">{{item.score}} 分</view>
            <view class="hour-value" style="color:{{item.suggestion ? '#28a745' : '#6c757d'}}">{{item.label}}</view>
          </view>
        </view>

        <view class="disclaimer">📊 融合预测基于 {{fusionResult.modelCount}} 个独立气象模式的加权平均，分歧度 ±{{fusionResult.stdDev}} 分。模式越一致，预测越可靠。</view>
      </view>
    </view>

    <!-- SOS -->
    <button class="sos-button" bindtap="onSOS">🆘 SOS 紧急求救</button>
  </view>

  <!-- Bottom Fixed Bar -->
  <view class="bottom-bar">
    <view class="bottom-btn" bindtap="onOpenPhoto">
      <text class="bottom-btn-icon">📸</text>
      <text class="bottom-btn-label">摄影参数</text>
    </view>
    <view class="bottom-btn" bindtap="onSOS">
      <text class="bottom-btn-icon">🆘</text>
      <text class="bottom-btn-label">紧急求救</text>
    </view>
    <view class="bottom-btn" open-type="share">
      <text class="bottom-btn-icon">📤</text>
      <text class="bottom-btn-label">分享</text>
    </view>
  </view>

  <!-- Photography Popup Panel -->
  <view class="photo-overlay {{showPhoto ? 'photo-overlay-show' : ''}}">
    <view class="photo-overlay-mask" bindtap="onClosePhoto"></view>
    <view class="photo-panel" catchtap="">
      <view class="photo-panel-header">
        <view class="photo-panel-title">📸 摄影参数推荐</view>
        <view class="photo-panel-close" bindtap="onClosePhoto">✕</view>
      </view>

      <scroll-view scroll-y class="photo-panel-body" wx:if="{{photoParams}}">
        <!-- Lighting & EV -->
        <view class="photo-hero">
          <view class="photo-hero-icon">{{photoParams.lighting.icon}}</view>
          <view class="photo-hero-phase">{{photoParams.lighting.label}}</view>
          <view class="photo-hero-ev">EV {{photoParams.ev}}</view>
        </view>
        <view class="photo-summary">{{photoParams.summary}}</view>

        <!-- Exposure Calculator (inspired by Planit) -->
        <view class="photo-section">
          <view class="photo-device-title">📐 曝光参数计算</view>
          <view class="exposure-table">
            <view class="exposure-row exposure-header">
              <view class="exposure-cell">光圈</view>
              <view class="exposure-cell">快门</view>
              <view class="exposure-cell">ISO</view>
              <view class="exposure-cell">场景</view>
            </view>
            <view wx:for="{{photoParams.exposureTable}}" wx:key="scene" class="exposure-row">
              <view class="exposure-cell exposure-value">{{item.aperture}}</view>
              <view class="exposure-cell exposure-value">{{item.shutter}}</view>
              <view class="exposure-cell exposure-value">{{item.iso}}</view>
              <view class="exposure-cell exposure-scene">{{item.scene}}</view>
            </view>
          </view>
        </view>

        <!-- Device Selector -->
        <view class="photo-section">
          <view class="photo-device-title">📷 选择你的设备</view>
          <view class="device-selectors" catchtap="">
            <view class="device-select-row">
              <text class="device-select-label">相机</text>
              <picker mode="selector" range="{{cameraPresets}}" range-key="label" bindchange="onSelectCamera" catchtap="">
                <view class="device-select-btn">{{cameraRec ? cameraRec.brand + ' ' + cameraRec.model : '选择相机型号 ▾'}}</view>
              </picker>
              <view wx:if="{{cameraRec}}" class="device-clear-btn" catchtap="onClearCamera">✕</view>
            </view>
            <view class="device-select-row">
              <text class="device-select-label">手机</text>
              <picker mode="selector" range="{{phonePresets}}" range-key="label" bindchange="onSelectPhone" catchtap="">
                <view class="device-select-btn">{{phoneRec ? phoneRec.brand + ' ' + phoneRec.model : '选择手机型号 ▾'}}</view>
              </picker>
              <view wx:if="{{phoneRec}}" class="device-clear-btn" catchtap="onClearPhone">✕</view>
            </view>
          </view>
        </view>

        <!-- Device-specific Camera Rec -->
        <view class="photo-section" wx:if="{{cameraRec}}">
          <view class="photo-device-title">📷 {{cameraRec.brand}} {{cameraRec.model}} 推荐设置</view>
          <view class="device-rec-hero">
            <view class="device-rec-lens">{{cameraRec.lens}}</view>
            <view class="device-rec-note">{{cameraRec.lensNote}}</view>
          </view>
          <view class="photo-grid">
            <view class="photo-param">
              <view class="photo-param-label">光圈</view>
              <view class="photo-param-value">{{cameraRec.aperture}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">快门</view>
              <view class="photo-param-value">{{cameraRec.shutter}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">感光度</view>
              <view class="photo-param-value">{{cameraRec.iso}}</view>
            </view>
          </view>
          <view wx:if="{{cameraRec.altLens}}" class="device-alt-lens">
            <text class="photo-param-label">备选镜头：</text>
            <text class="photo-param-value">{{cameraRec.altLens.name}}</text>
            <text class="photo-param-note"> — {{cameraRec.altLens.note}}</text>
          </view>
          <view class="photo-device-title" style="font-size:24rpx;margin-top:16rpx;">全部镜头</view>
          <view wx:for="{{cameraRec.allLenses}}" wx:key="name" class="device-lens-item">
            <text class="device-lens-name">{{item.name}}</text>
            <text class="device-lens-aperture">{{item.bestAperture}}</text>
            <text class="device-lens-note">{{item.note}}</text>
          </view>
          <view class="forecast-reasons" style="margin-top:12rpx;">
            <view wx:for="{{cameraRec.tips}}" wx:key="index" class="reason-item">{{item}}</view>
          </view>
        </view>

        <!-- Device-specific Phone Rec -->
        <view class="photo-section" wx:if="{{phoneRec}}">
          <view class="photo-device-title">📱 {{phoneRec.brand}} {{phoneRec.model}} 推荐</view>
          <view class="device-rec-hero" wx:if="{{phoneRec.primaryLens}}">
            <view class="device-rec-lens">首选：{{phoneRec.primaryLens.name}}</view>
            <view class="device-rec-note">{{phoneRec.primaryLens.note}} · 最佳用于{{phoneRec.primaryLens.bestFor}}</view>
          </view>
          <view class="device-rec-hero" wx:if="{{phoneRec.altLens}}" style="margin-top:8rpx;">
            <view class="device-rec-lens">辅助：{{phoneRec.altLens.name}}</view>
            <view class="device-rec-note">{{phoneRec.altLens.note}} · {{phoneRec.altLens.bestFor}}</view>
          </view>
          <view class="photo-grid" style="margin-top:12rpx;">
            <view class="photo-param">
              <view class="photo-param-label">拍摄模式</view>
              <view class="photo-param-value">{{phoneRec.mode}}</view>
              <view class="photo-param-note">{{phoneRec.modeNote}}</view>
            </view>
          </view>
          <view class="photo-grid" style="margin-top:8rpx;">
            <view class="photo-param">
              <view class="photo-param-label">专业模式 ISO</view>
              <view class="photo-param-value">{{phoneRec.proSettings.iso}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">专业模式快门</view>
              <view class="photo-param-value">{{phoneRec.proSettings.shutter}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">白平衡</view>
              <view class="photo-param-value">{{phoneRec.proSettings.wb}}</view>
            </view>
          </view>
          <view class="photo-device-title" style="font-size:24rpx;margin-top:16rpx;">全部镜头</view>
          <view wx:for="{{phoneRec.allLenses}}" wx:key="name" class="device-lens-item">
            <text class="device-lens-name">{{item.name}}</text>
            <text class="device-lens-note">{{item.note}} · {{item.bestFor}}</text>
          </view>
          <view class="forecast-reasons" style="margin-top:12rpx;">
            <view wx:for="{{phoneRec.features}}" wx:key="index" class="reason-item">{{item}}</view>
          </view>
          <view class="photo-param-note" style="margin-top:8rpx;">延时：{{phoneRec.timelapse}}</view>
        </view>

        <!-- Generic Camera (when no device selected) -->
        <view class="photo-section" wx:if="{{!cameraRec}}">
          <view class="photo-device-title">🎞️ 单反 / 微单推荐</view>
          <view class="photo-grid">
            <view class="photo-param">
              <view class="photo-param-label">光圈</view>
              <view class="photo-param-value">{{photoParams.camera.aperture}}</view>
              <view class="photo-param-note">{{photoParams.camera.apertureNote}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">快门</view>
              <view class="photo-param-value">{{photoParams.camera.shutter}}</view>
              <view class="photo-param-note">{{photoParams.camera.shutterNote}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">ISO</view>
              <view class="photo-param-value">{{photoParams.camera.iso}}</view>
              <view class="photo-param-note">{{photoParams.camera.isoNote}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">白平衡</view>
              <view class="photo-param-value">{{photoParams.camera.wb}}</view>
              <view class="photo-param-note">{{photoParams.camera.wbNote}}</view>
            </view>
          </view>
          <view class="photo-grid" style="margin-top:12rpx;">
            <view class="photo-param" style="min-width:100%;">
              <view class="photo-param-label">焦段建议</view>
              <view class="photo-param-value">{{photoParams.camera.focal}}</view>
              <view class="photo-param-note">{{photoParams.camera.focalNote}}</view>
            </view>
          </view>

          <!-- DOF info -->
          <view class="photo-grid" style="margin-top:12rpx;" wx:if="{{photoParams.depthOfField}}">
            <view class="photo-param">
              <view class="photo-param-label">景深范围</view>
              <view class="photo-param-value">{{photoParams.depthOfField.range}}</view>
              <view class="photo-param-note">{{photoParams.depthOfField.note}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">超焦距</view>
              <view class="photo-param-value">{{photoParams.depthOfField.hyperfocal}}</view>
              <view class="photo-param-note">对焦到此距离可获得最大景深</view>
            </view>
          </view>
        </view>

        <!-- Filters -->
        <view class="photo-section" wx:if="{{photoParams.filters.length}}">
          <view class="photo-device-title">🔘 滤镜建议</view>
          <view wx:for="{{photoParams.filters}}" wx:key="name" class="filter-item">
            <text class="filter-dot filter-{{item.priority}}">●</text>
            <text class="filter-name">{{item.name}}</text>
            <text class="filter-reason">{{item.reason}}</text>
          </view>
        </view>

        <!-- Sun/Moon -->
        <view class="photo-section" wx:if="{{photoParams.celestial}}">
          <view class="photo-device-title">🌅 日月方位</view>
          <view class="photo-grid">
            <view class="photo-param">
              <view class="photo-param-label">日出</view>
              <view class="photo-param-value">{{photoParams.celestial.sunrise}}</view>
              <view class="photo-param-note">{{photoParams.celestial.sunriseDir}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">日落</view>
              <view class="photo-param-value">{{photoParams.celestial.sunset}}</view>
              <view class="photo-param-note">{{photoParams.celestial.sunsetDir}}</view>
            </view>
          </view>
        </view>

        <!-- Phone (generic, when no device selected) -->
        <view class="photo-section" wx:if="{{!phoneRec}}">
          <view class="photo-device-title">📱 手机拍摄</view>
          <view class="photo-grid">
            <view class="photo-param">
              <view class="photo-param-label">拍摄模式</view>
              <view class="photo-param-value">{{photoParams.phone.mode}}</view>
              <view class="photo-param-note">{{photoParams.phone.modeNote}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">镜头选择</view>
              <view class="photo-param-value">{{photoParams.phone.lens}}</view>
            </view>
          </view>
          <view class="forecast-reasons" style="margin-top:8rpx;">
            <view wx:for="{{photoParams.phone.tips}}" wx:key="index" class="reason-item">{{item}}</view>
          </view>
        </view>

        <!-- Composition -->
        <view class="photo-section" wx:if="{{photoParams.composition.length}}">
          <view class="photo-device-title">🎨 构图建议</view>
          <view class="forecast-reasons">
            <view wx:for="{{photoParams.composition}}" wx:key="index" class="reason-item">{{item}}</view>
          </view>
        </view>

        <!-- Shooting Timeline -->
        <view class="photo-section" wx:if="{{photoParams.timeline.length}}">
          <view class="photo-device-title">⏱️ 拍摄时间轴</view>
          <view class="timeline-bar">
            <view wx:for="{{photoParams.timeline}}" wx:key="label" class="timeline-segment" style="flex:{{item.durationMin}};background:{{item.color}};">
              <view class="timeline-label">{{item.icon}}</view>
            </view>
          </view>
          <view class="timeline-list">
            <view wx:for="{{photoParams.timeline}}" wx:key="label" class="timeline-item">
              <text class="timeline-time">{{item.startTime}}-{{item.endTime}}</text>
              <text class="timeline-icon">{{item.icon}}</text>
              <text class="timeline-name">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- ND Calculator -->
        <view class="photo-section" wx:if="{{photoParams.ndCalc}}">
          <view class="photo-device-title">🔢 ND 减光计算</view>
          <view class="photo-grid">
            <view class="photo-param">
              <view class="photo-param-label">目标 2 秒快门需要</view>
              <view class="photo-param-value">{{photoParams.ndCalc.filter}}</view>
              <view class="photo-param-note">减光 {{photoParams.ndCalc.stops}} 档</view>
            </view>
          </view>
        </view>

        <!-- Timelapse -->
        <view class="photo-section" wx:if="{{photoParams.timelapse}}">
          <view class="photo-device-title">🎥 延时摄影建议</view>
          <view class="photo-grid">
            <view class="photo-param">
              <view class="photo-param-label">拍摄间隔</view>
              <view class="photo-param-value">{{photoParams.timelapse.interval}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">建议时长</view>
              <view class="photo-param-value">{{photoParams.timelapse.duration}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">预计张数</view>
              <view class="photo-param-value">{{photoParams.timelapse.frames}}</view>
            </view>
            <view class="photo-param">
              <view class="photo-param-label">成片长度</view>
              <view class="photo-param-value">{{photoParams.timelapse.videoLength}}</view>
            </view>
          </view>
          <view class="photo-param-note" style="margin-top:8rpx;">{{photoParams.timelapse.note}}</view>
          <view class="forecast-reasons" style="margin-top:8rpx;">
            <view wx:for="{{photoParams.timelapse.tips}}" wx:key="index" class="reason-item">{{item}}</view>
          </view>
        </view>

        <view class="disclaimer" style="margin-bottom:40rpx;">参考自巧摄(Planit)曝光计算思路，参数基于当前天气条件自动推算，实际拍摄请根据现场光线微调。</view>
      </scroll-view>
    </view>
  </view>
</view>
