/* Page-specific styles */
.page-container {
  padding: 20rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
}

/* Bottom fixed bar */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(9, 14, 26, 0.95);
  border-top: 1rpx solid rgba(173, 199, 255, 0.15);
  padding: 12rpx 0;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 100;
  backdrop-filter: blur(20px);
}

.bottom-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 32rpx;
}

.bottom-btn-icon {
  font-size: 40rpx;
}

.bottom-btn-label {
  font-size: 20rpx;
  color: #aab4c5;
}

/* Photography popup panel */
.photo-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 200;
  display: none;
  justify-content: flex-end;
  flex-direction: column;
}

.photo-overlay-show {
  display: flex;
  animation: fadeIn 0.2s;
}

.photo-overlay-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.photo-panel {
  background: #0d1526;
  border-radius: 28rpx 28rpx 0 0;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
  position: relative;
  z-index: 1;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.photo-panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 1rpx solid rgba(173, 199, 255, 0.12);
}

.photo-panel-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.photo-panel-close {
  font-size: 36rpx;
  color: #aab4c5;
  padding: 8rpx 16rpx;
}

.photo-panel-body {
  padding: 20rpx 32rpx;
  flex: 1;
}

.photo-hero {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.photo-hero-icon {
  font-size: 56rpx;
}

.photo-hero-phase {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
}

.photo-hero-ev {
  font-size: 26rpx;
  color: #3aa4ff;
  background: rgba(58, 164, 255, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-left: auto;
}

.photo-section {
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(173, 199, 255, 0.08);
}

/* Exposure table (Planit style) */
.exposure-table {
  border-radius: 12rpx;
  overflow: hidden;
  margin-top: 12rpx;
}

.exposure-row {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(173, 199, 255, 0.06);
}

.exposure-header {
  color: #aab4c5;
  font-size: 22rpx;
  font-weight: 600;
}

.exposure-cell {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
}

.exposure-value {
  color: #fff;
  font-weight: 500;
  font-size: 26rpx;
}

.exposure-scene {
  color: #aab4c5;
  font-size: 22rpx;
  text-align: right;
  flex: 1.5;
}

/* Collapsible sections */
.collapsible-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.collapse-arrow {
  font-size: 22rpx;
  color: #aab4c5;
  margin-left: 12rpx;
}

.collapsed-summary {
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #aab4c5;
  text-align: center;
}

/* Error state */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  margin-top: 40rpx;
}

.error-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.error-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 12rpx;
}

.error-hint {
  font-size: 24rpx;
  color: #aab4c5;
  margin-bottom: 32rpx;
  text-align: center;
}

.error-retry-btn {
  padding: 16rpx 48rpx;
  background: #3aa4ff;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

/* Search History */
.search-history {
  padding: 12rpx 0;
}

.search-history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.search-history-label {
  font-size: 22rpx;
  color: var(--color-text-secondary, #aab4c5);
}

.search-history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-tag {
  padding: 8rpx 20rpx;
  background: rgba(58, 164, 255, 0.12);
  border: 1rpx solid rgba(58, 164, 255, 0.25);
  border-radius: 20rpx;
  font-size: 24rpx;
  color: var(--color-primary, #3aa4ff);
}

/* Favorites */
.fav-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  font-size: 24rpx;
  color: var(--color-primary, #3aa4ff);
  margin-top: 8rpx;
}

.fav-tag {
  background: rgba(255, 193, 7, 0.12);
  border-color: rgba(255, 193, 7, 0.3);
  color: #ffc107;
}
